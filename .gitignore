# ── Dependencies & build output ──────────────────────────────
app/web/node_modules/
app/web/dist/
app/web/.vite/
**/node_modules/
**/__pycache__/
*.pyc
.venv/
venv/

# ── Large / incoming research data (tracked out of git) ───────
# data/research-data holds the raw research downloads (multi-GB) and the
# friend's data zip. These are ingested into the DB, not version-controlled.
data/research-data/
*.crdownload
*.part

# ── Large raw harvested source files from the friend's bundle ──
# Kept locally (used for normalization + the DEM/geo feature join) but too
# bulky to commit. The normalized schema-clean listings CSV IS committed.
data/raw/friend/listings/
data/raw/friend/geo/
data/raw/friend/official/
data/raw/friend/zoning/
!data/raw/friend/listings_friend_geocoded.csv

