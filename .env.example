# Copy to .env and fill in. The .env file is gitignored — never commit real credentials.
# This SINGLE root .env drives both sides:
#   - Backend  : DATABASE_URL + GROQ_API_KEY (python-dotenv in app/api/main.py)
#   - Frontend : VITE_API_BASE (Vite reads this file via envDir="../.." in vite.config.ts)
# Only VITE_-prefixed vars reach the browser, so the two secrets stay server-side.

# Neon Postgres connection string for the Jordan Real Estate Intelligence API.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require
# Groq API key for the grounded chat assistant.
GROQ_API_KEY=gsk_xxxx
# Backend API base URL for the frontend (pricing + chat). Unset -> localhost:8000 in dev.
VITE_API_BASE=https://real-estate-jordan-v2-4if8.vercel.app
