# Frontend environment. Copy to `.env` for local overrides:  cp .env.example .env
# Vite only exposes variables prefixed with VITE_ to the browser, and they are
# baked in at BUILD time (so on Vercel, set them in the project's Environment
# Variables and redeploy — editing a deployed build's env has no effect).

# Base URL of the backend API (recommendation engine + the grounded /chat assistant).
# Both the pricing calls and the chat use this single value.
#
#   - Local dev:   leave unset to auto-use http://localhost:8000, or point it at a
#                  deployed backend to develop against live data.
#   - Production:  set this in the Vercel frontend project's Environment Variables
#                  to your deployed backend URL.
#
# If unset, the app falls back to http://localhost:8000 in dev and the deployed
# backend URL in production builds.
VITE_API_BASE=https://real-estate-jordan-v2-4if8.vercel.app
